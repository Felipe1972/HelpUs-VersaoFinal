{
  "name": "help-us-backend",
  "version": "1.0.0",
  "description": "API REST da primeira entrega do projeto Help Us",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/chat-unit.test.js tests/ocorrencias.test.js tests/permissoes.test.js",
